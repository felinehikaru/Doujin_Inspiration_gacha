page {
  background: linear-gradient(#ffffff, #f2f2f2);
}

.container {
  min-height: 100vh;
  padding: 36rpx 30rpx 70rpx;
  box-sizing: border-box;
}

.intro {
  padding: 22rpx 8rpx 42rpx;
  text-align: center;
}

.title {
  display: block;
  font-size: 50rpx;
  font-weight: 800;
  color: #5c3a3a;
}

.subtitle {
  display: block;
  margin-top: 12rpx;
  color: #9a7d80;
  font-size: 28rpx;
}

.section {
  margin-bottom: 42rpx;
}

.section-title {
  display: block;
  margin: 0 0 18rpx 8rpx;
  color: #6b4a4a;
  font-size: 33rpx;
  font-weight: 700;
}

.achievement-card {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 22rpx;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, .08);
}

.hidden-card {
  background: linear-gradient(135deg, #f3f3f3, #fff);
}

.achievement-icon {
  width: 92rpx;
  margin-right: 22rpx;
  font-size: 62rpx;
  text-align: center;
}

.achievement-info {
  flex: 1;
  min-width: 0;
}

.achievement-name,
.achievement-desc {
  display: block;
}

.achievement-name {
  color: #5c3a3a;
  font-size: 33rpx;
  font-weight: 700;
}

.achievement-desc {
  margin-top: 8rpx;
  color: #9a7d80;
  font-size: 27rpx;
}

.progress-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
}

.progress-track {
  flex: 1;
  height: 12rpx;
  overflow: hidden;
  background: #ececec;
  border-radius: 20rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #d87070, #e0a0a8);
  border-radius: inherit;
}

.progress-text {
  color: #9a7d80;
  font-size: 24rpx;
}

.hidden-empty {
  padding: 42rpx;
  color: #b0a0a0;
  text-align: center;
  font-size: 26rpx;
  background: rgba(255, 255, 255, .55);
  border-radius: 22rpx;
}
/* ===== 页面标题图标（主界面同款，48rpx 缩放版） ===== */
.title-with-icon,
.title-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.page-icon {
  width: 48rpx;
  height: 48rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* 历史：时钟（蓝） */
.page-icon.icon-history {
  border: 3rpx solid #6a9fc8;
  border-radius: 50%;
  box-sizing: border-box;
}

.page-icon.icon-history .clock-hand {
  position: absolute;
  background: #6a9fc8;
  border-radius: 2rpx;
}

.page-icon.icon-history .clock-hand-v {
  width: 4rpx;
  height: 14rpx;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -100%);
  transform-origin: bottom center;
}

.page-icon.icon-history .clock-hand-h {
  width: 10rpx;
  height: 4rpx;
  left: 50%;
  top: 50%;
  transform: translateY(-50%);
}

/* 收藏：五角星（黄，空心） */
.page-icon.icon-favorite {
  position: relative;
  background: #e0b848;
  clip-path: polygon(
    50% 0%,
    61% 35%,
    98% 35%,
    68% 57%,
    79% 91%,
    50% 70%,
    21% 91%,
    32% 57%,
    2% 35%,
    39% 35%
  );
}

.page-icon.icon-favorite::after {
  content: '';
  position: absolute;
  inset: 5rpx;
  background: #fdfbf5;
  clip-path: polygon(
    50% 0%,
    61% 35%,
    98% 35%,
    68% 57%,
    79% 91%,
    50% 70%,
    21% 91%,
    32% 57%,
    2% 35%,
    39% 35%
  );
}

/* 词条中心：打开的书（绿） */
.page-icon.icon-entries .book-page {
  position: absolute;
  top: 7rpx;
  width: 19rpx;
  height: 33rpx;
  border: 3rpx solid #6ab88a;
  box-sizing: border-box;
}

.page-icon.icon-entries .book-left {
  left: 4rpx;
  border-right: none;
  border-radius: 5rpx 0 0 5rpx;
  transform: skewY(-4deg);
  transform-origin: right center;
}

.page-icon.icon-entries .book-right {
  right: 4rpx;
  border-left: none;
  border-radius: 0 5rpx 5rpx 0;
  transform: skewY(4deg);
  transform-origin: left center;
}

/* 成就：奖杯（红） */
.page-icon.icon-achievement .trophy-cup {
  position: absolute;
  left: 50%;
  top: 3rpx;
  transform: translateX(-50%);
  width: 28rpx;
  height: 21rpx;
  border: 4rpx solid #d87070;
  border-top: none;
  border-radius: 0 0 12rpx 12rpx;
  box-sizing: border-box;
}

.page-icon.icon-achievement .trophy-cup::before {
  content: '';
  position: absolute;
  left: -8rpx;
  top: 2rpx;
  width: 6rpx;
  height: 10rpx;
  border: 3rpx solid #d87070;
  border-right: none;
  border-radius: 8rpx 0 0 8rpx;
}

.page-icon.icon-achievement .trophy-cup::after {
  content: '';
  position: absolute;
  right: -8rpx;
  top: 2rpx;
  width: 6rpx;
  height: 10rpx;
  border: 3rpx solid #d87070;
  border-left: none;
  border-radius: 0 8rpx 8rpx 0;
}

.page-icon.icon-achievement .trophy-stem {
  position: absolute;
  left: 50%;
  top: 26rpx;
  transform: translateX(-50%);
  width: 6rpx;
  height: 8rpx;
  background: #d87070;
}

.page-icon.icon-achievement .trophy-base {
  position: absolute;
  left: 50%;
  bottom: 4rpx;
  transform: translateX(-50%);
  width: 21rpx;
  height: 6rpx;
  background: #d87070;
  border-radius: 2rpx;
}

/* ===== 主页面同款装饰：云朵 + 四角星 ===== */
page {
  background: linear-gradient(#ffffff, #f2f2f2);
}

.container {
  position: relative;
  overflow: hidden;
  background: linear-gradient(#ffffff, #f2f2f2);
}

/* 底部云朵：圆 + 底座，横穿屏幕 */
.cloud-bg {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  width: 100vw;
  bottom: -20rpx;
  height: 280rpx;
  z-index: 0;
  pointer-events: none;
}

.cloud-bg-base {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 80rpx;
  background: #ececec;
}

.cb {
  position: absolute;
  background: #f6e2e2;
  border-radius: 50%;
  bottom: 0;
}

/* 四角星装饰（菱形芒星） */
.sparkle-deco {
  position: absolute;
  z-index: 2;
  clip-path: polygon(
    50% 0%,
    65% 35%,
    100% 50%,
    65% 65%,
    50% 100%,
    35% 65%,
    0% 50%,
    35% 35%
  );
  animation: sparkle-float 3s ease-in-out infinite;
}
/* 随机四角星装饰（页面级） */
.page-sparkles {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 0;
  overflow: hidden;
}


@keyframes sparkle-float {
  0%, 100% {
    transform: translateY(0) rotate(0deg);
    opacity: 0.85;
  }
  50% {
    transform: translateY(-10rpx) rotate(15deg);
    opacity: 1;
  }
}

/* 内容浮在云朵之上 */
.title,
.title-row,
.header,
.intro {
  position: relative;
  z-index: 2;
}

.section {
  position: relative;
  z-index: 1;
}

.achievement-icon-img {
  width: 92rpx;
  height: 92rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
  margin-right: 22rpx;
  box-sizing: border-box;
}

/* ===== 成就展开/收起按钮 ===== */
.expand-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  margin: -4rpx 0 18rpx;
  color: #8aa8b5;
  font-size: 26rpx;
  background: rgba(255, 255, 255, 0.75);
  border-radius: 20rpx;
}
.expand-arrow {
  color: #8aa8b5;
  letter-spacing: 2rpx;
}
