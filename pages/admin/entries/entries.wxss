.container {
  padding: 30rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
}

.filter-area {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.filter-btn {
  padding: 12rpx 25rpx;
  border-radius: 30rpx;
  background: #f3f3f3;
}

.search {
  margin: 30rpx 0;
  border: 1px solid #ddd;
  padding: 20rpx;
  border-radius: 20rpx;
}

.action-row {
  display: flex;
  gap: 20rpx;
}

.btn {
  font-size: 28rpx;
}

.count {
  margin: 25rpx 0;
  color: #888;
}

.entry-card {
  padding: 25rpx;
  margin-bottom: 20rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 5rpx 20rpx rgba(0, 0, 0, .08);
}

.entry-title {
  font-size: 34rpx;
  font-weight: bold;
  display: block;
}

.entry-desc {
  display: block;
  margin-top: 15rpx;
}

.entry-category {
  display: block;
  margin-top: 15rpx;
  color: #666;
}

.entry-tags {
  display: block;
  margin-top: 10rpx;
  color: #999;
}

.upload-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, .4);
  display: flex;
  justify-content: center;
  align-items: center;
}

.upload-box {
  width: 80%;
  background: white;
  padding: 40rpx;
  border-radius: 30rpx;
}

.upload-title {
  font-size: 35rpx;
  font-weight: bold;
}

.picker {
  padding: 20rpx;
  margin: 20rpx 0;
  background: #eee;
}

.upload-buttons {
  display: flex;
  justify-content: space-between;
}