/* pages/admin/admin.wxss
   主题：浅金杏（审核按钮黄） + 词条中心绿 + 标题栏灰蓝 */

page {
  background: linear-gradient(180deg, #ffffff, #f7f4ea);
}

.container {
  min-height: 100vh;
  padding: 30rpx;
  box-sizing: border-box;
}

/* =====================
   标题
===================== */
.header {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 14rpx;
  margin-bottom: 30rpx;
  padding: 0 6rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 800;
  color: #5a7f92;
}

.count-badge {
  padding: 8rpx 22rpx;
  background: #f5e9c9;
  border: 2rpx solid #ead9a8;
  border-radius: 30rpx;
  color: #8a7140;
  font-size: 24rpx;
  font-weight: 600;
}

/* =====================
   词条卡片
===================== */
.entry-card {
  background: #ffffff;
  border: 2rpx solid #eef0e6;
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 8rpx 20rpx rgba(138, 113, 64, 0.08);
}

.entry-info {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 12rpx;
}

.entry-text {
  font-size: 34rpx;
  font-weight: 700;
  color: #33454e;
  line-height: 1.3;
}

.category-badge {
  padding: 6rpx 18rpx;
  background: #eaf5ec;
  border: 2rpx solid #d3e8d9;
  border-radius: 22rpx;
  color: #3f7a56;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.2;
}

.entry-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.3;
  color: #6b7066;
}

.entry-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 8rpx;
}

.tag {
  color: #5a7f92;
  font-size: 23rpx;
  line-height: 1.3;
}

.entry-time {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #a89a78;
  line-height: 1.3;
}

/* =====================
   操作按钮
===================== */
.entry-actions {
  display: flex;
  justify-content: flex-end;
  gap: 14rpx;
  margin-top: 26rpx;
  padding-top: 20rpx;
  border-top: 2rpx dashed #f0ecd9;
}

.entry-actions button {
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 26rpx;
  border-radius: 30rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: #fff;
}

.btn-edit {
  background: #b3ccd8;
  box-shadow: 0 4rpx 12rpx rgba(143, 179, 196, 0.25);
}

.btn-approve {
  background: #92c8a4;
  box-shadow: 0 4rpx 12rpx rgba(111, 174, 131, 0.25);
}

.btn-reject {
  background: #e2b3ba;
  box-shadow: 0 4rpx 12rpx rgba(216, 150, 158, 0.22);
}

/* =====================
   空状态
===================== */
.empty {
  margin-top: 120rpx;
  padding: 80rpx 40rpx;
  text-align: center;
  background: #fbf8ef;
  border: 2rpx dashed #e8dcc0;
  border-radius: 24rpx;
  color: #a89a78;
  font-size: 30rpx;
}

/* =====================
   编辑弹窗
===================== */
.edit-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, .45);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 100;
}

.edit-panel {
  width: 650rpx;
  background: #ffffff;
  border-radius: 30rpx;
  padding: 40rpx;
  box-sizing: border-box;
}

.edit-title {
  display: block;
  text-align: center;
  font-size: 36rpx;
  font-weight: bold;
  color: #5a7f92;
  margin-bottom: 30rpx;
}

.edit-label {
  display: block;
  margin-top: 20rpx;
  margin-bottom: 10rpx;
  font-size: 26rpx;
  color: #6b7066;
}

.edit-input {
  height: 70rpx;
  padding: 0 20rpx;
  background: #f7f4ea;
  border-radius: 16rpx;
  font-size: 28rpx;
}

.edit-textarea {
  width: 100%;
  height: 180rpx;
  padding: 20rpx;
  box-sizing: border-box;
  background: #f7f4ea;
  border-radius: 16rpx;
  font-size: 28rpx;
}

.category-picker {
  height: 70rpx;
  line-height: 70rpx;
  padding: 0 20rpx;
  background: #f7f4ea;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #555;
}

/* =====================
   弹窗按钮
===================== */
.edit-actions {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  margin-top: 40rpx;
}

.edit-actions button {
  width: 180rpx;
  height: 70rpx;
  line-height: 70rpx;
  border-radius: 35rpx;
  font-size: 28rpx;
}

.cancel-btn {
  background: #ece7d8;
  color: #8a7140;
}

.save-btn {
  background: #8fb3c4;
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(143, 179, 196, 0.35);
}
