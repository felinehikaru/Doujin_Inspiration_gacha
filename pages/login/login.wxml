<view class="container">
  <view class="title">
    <text class="title-text">👤 用户中心</text>
  </view>

  <!-- 未登录 -->
  <view wx:if="{{role==='visitor'}}" class="user-card">
    <text class="status">当前未登录</text>
    <button class="login-btn" open-type="getUserProfile" bindtap="login">微信登录</button>
  </view>

  <!-- 已登录 -->
  <view wx:else class="user-card">
    <text class="status">当前身份：{{role}}</text>
    <button class="logout-btn" bindtap="logout">登出</button>
    <button class="delete-btn" bindtap="deleteAccount">账户注销</button>
  </view>
</view>