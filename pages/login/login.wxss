}

/* ===== 主页面同款装饰 ===== */

/* 底部云朵：圆 + 底座，横穿屏幕 */
.cloud-bg {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  width: 100vw;
  bottom: -20rpx;
  height: 280rpx;
  z-index: 0;
  pointer-events: none;
}

.cloud-bg-base {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 80rpx;
  background: #ece4f5;
}

.cb {
  position: absolute;
  background: #ece4f5;
  border-radius: 50%;
  bottom: 0;
}

/* 四角星装饰（菱形芒星） */
.sparkle-deco {
  position: absolute;
  z-index: 2;
  clip-path: polygon(
    50% 0%,
    65% 35%,
    100% 50%,
    65% 65%,
    50% 100%,
    35% 65%,
    0% 50%,
    35% 35%
  );
  animation: sparkle-float 3s ease-in-out infinite;
}

.sparkle-1 {
  width: 30rpx;
  height: 30rpx;
  left: 84rpx;
  top: 2rpx;
  background: #c9bfe8;
}

.sparkle-2 {
  width: 38rpx;
  height: 38rpx;
  right: 70rpx;
  top: 14rpx;
  background: #e8d5a3;
  animation-delay: 0.6s;
}

.sparkle-3 {
  width: 22rpx;
  height: 22rpx;
  left: 190rpx;
  top: 44rpx;
  background: #c9bfe8;
  animation-delay: 1.2s;
}

@keyframes sparkle-float {
  0%, 100% {
    transform: translateY(0) rotate(0deg);
    opacity: 0.85;
  }
  50% {
    transform: translateY(-10rpx) rotate(15deg);
    opacity: 1;
  }
}
