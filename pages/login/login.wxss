page {
  background: linear-gradient(#ffffff, #f7f4ff);
}

.container {
  min-height: 100vh;
  padding: 40rpx;
  background: linear-gradient(#ffffff, #f7f4ff);
  position: relative;
  overflow: hidden;
}

.title {
  text-align: center;
  margin-bottom: 60rpx;
  position: relative;
  z-index: 2;
}

.title-text {
  font-size: 48rpx;
  font-weight: 900;
  color: #333;
}

.user-card {
  background: #fff;
  border-radius: 30rpx;
  padding: 50rpx 30rpx;
  box-shadow: 0 10rpx 30rpx rgba(139, 92, 246, .14);
  position: relative;
  z-index: 2;
}

.status {
  display: block;
  text-align: center;
  font-size: 32rpx;
  color: #555;
  margin-bottom: 40rpx;
}

button {
  height: 90rpx;
  line-height: 90rpx;
  border-radius: 45rpx;
  font-size: 32rpx;
  color: #fff;
  margin-top: 30rpx;
}

.login-btn-wrap {
  position: relative;
  width: fit-content;
  margin: 0 auto;
}

/* ===== 居中昵称确认面板 ===== */
.nick-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 999;
}

.nick-panel {
  width: 560rpx;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 48rpx 40rpx 36rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 16rpx 50rpx rgba(0, 0, 0, 0.18);
}

.nick-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
}

.nick-desc {
  margin-top: 18rpx;
  font-size: 26rpx;
  color: #888;
  text-align: center;
  line-height: 1.5;
}

/* 隐藏的昵称输入框：自动聚焦唤起微信底部昵称面板，不占视觉空间 */
.nick-hidden-input {
  position: absolute;
  left: 0;
  top: 0;
  width: 1rpx;
  height: 1rpx;
  opacity: 0;
  z-index: -1;
}

.nick-actions {
  width: 100%;
  margin-top: 24rpx;
}

.nick-cancel {
  width: 100% !important;
  height: 72rpx;
  line-height: 72rpx;
  background: #ececf0;
  color: #666;
  font-size: 28rpx;
  border-radius: 36rpx;
}

.login-btn {
  background: #8bb1bf;
  width: fit-content !important;
  min-width: 0 !important;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 60rpx;
  margin: 0 auto;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 32rpx;
  border-radius: 38rpx;
}

.login-btn::after {
  border: none;
}

/* 登出/注销：fit-content 让宽度只包裹文字，块级独占一行居中 */
.logout-btn,
.delete-btn {
  width: fit-content !important;
  min-width: 0 !important;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 40rpx;
  margin: 0 auto;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 28rpx;
  border-radius: 32rpx;
}

.logout-btn {
  background: #8bb1bf;
  margin-top: 24rpx;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 36rpx !important;
  border-radius: 32rpx;
}

.delete-btn {
  background: #d98f9b;
  margin-top: 28rpx;
  height: 52rpx;
  line-height: 52rpx;
  padding: 0 24rpx !important;
  font-size: 26rpx;
  border-radius: 26rpx;
}

/* 标题图标（CSS 人形，主题灰蓝色） */
.title-with-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.page-icon {
  width: 48rpx;
  height: 48rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.icon-user .user-head {
  position: absolute;
  top: 2rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #c4b8e0;
}

.icon-user .user-body {
  position: absolute;
  bottom: 2rpx;
  width: 36rpx;
  height: 20rpx;
  border-radius: 18rpx 18rpx 10rpx 10rpx;
  background: #c4b8e0;
}

/* ===== 主页面同款装饰 ===== */

/* 底部云朵：圆 + 底座，横穿屏幕 */
.cloud-bg {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  width: 100vw;
  bottom: -20rpx;
  height: 280rpx;
  z-index: 0;
  pointer-events: none;
}

.cloud-bg-base {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 80rpx;
  background: #ece4f5;
}

.cb {
  position: absolute;
  background: #ece4f5;
  border-radius: 50%;
  bottom: 0;
}

/* 四角星装饰（菱形芒星） */
.sparkle-deco {
  position: absolute;
  z-index: 2;
  clip-path: polygon(
    50% 0%,
    65% 35%,
    100% 50%,
    65% 65%,
    50% 100%,
    35% 65%,
    0% 50%,
    35% 35%
  );
  animation: sparkle-float 3s ease-in-out infinite;
}

.sparkle-1 {
  width: 30rpx;
  height: 30rpx;
  left: 84rpx;
  top: 2rpx;
  background: #c9bfe8;
}

.sparkle-2 {
  width: 38rpx;
  height: 38rpx;
  right: 70rpx;
  top: 14rpx;
  background: #e8d5a3;
  animation-delay: 0.6s;
}

.sparkle-3 {
  width: 22rpx;
  height: 22rpx;
  left: 190rpx;
  top: 44rpx;
  background: #c9bfe8;
  animation-delay: 1.2s;
}

@keyframes sparkle-float {
  0%, 100% {
    transform: translateY(0) rotate(0deg);
    opacity: 0.85;
  }
  50% {
    transform: translateY(-10rpx) rotate(15deg);
    opacity: 1;
  }
}
