<!-- pages/favorites/favorites.wxml -->

<view class="container">
  <view class="title">
    <text class="title-text">⭐ 我的收藏</text>
    <text class="subtitle">保存喜欢的灵感组合</text>
  </view>

  <view class="favorite-list">
    <view wx:if="{{!favorites.length}}" class="empty">
      暂无收藏组合
    </view>

    <view wx:for="{{favorites}}" wx:key="index" class="favorite-card">
      <view class="favorite-text">
        <text>{{item.text || item}}</text>
      </view>

      <view class="favorite-actions">

        <button class="copy-btn" 
        data-index="{{index}}" 
        bindtap="copyFavorite">复制</button>

        <button class="prompt-btn" 
        data-index="{{index}}" 
        bindtap="createPrompt">提示词模板</button>

        <button class="delete-btn" 
        data-index="{{index}}" 
        bindtap="deleteFavorite">删除</button>

      </view>
    </view>
  </view>
</view>