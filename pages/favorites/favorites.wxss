/* pages/favorites/favorites.wxss */

/* =====================
 页面基础
===================== */
page {
  background: #ffffff;
}

.container {
  min-height: 100vh;
  background: #ffffff;
  padding: 30rpx;
}

/* =====================
标题
===================== */
.title {
  text-align: center;
  margin-bottom: 35rpx;
}

.title-text {
  display: block;
  font-size: 42rpx;
  font-weight: 900;
  color: #333;
}

.subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #888;
}

/* =====================
收藏列表
===================== */
.favorite-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

/* =====================
收藏卡片
===================== */
.favorite-card {
  background: #fafafa;
  border-radius: 22rpx;
  padding: 24rpx;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, .08);
}

.favorite-text {
  font-size: 32rpx;
  color: #333;
  line-height: 1.5;
}

/* =====================
操作按钮
===================== */
.favorite-actions {
  margin-top: 20rpx;
  display: flex;
  justify-content: flex-end;
  gap: 14rpx;
}

.copy-btn,
.prompt-btn,
.delete-btn {
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 28rpx;
  border-radius: 35rpx;
  color: #fff;
  font-size: 26rpx;
  font-weight: bold;
}

.copy-btn {
  background: #8fa3bf;
}

.prompt-btn {
  background: #b09ac9;
}

.delete-btn {
  background: #d98f9b;
}

/* =====================
空状态
===================== */
.empty {
  text-align: center;
  margin-top: 200rpx;
  color: #999;
  font-size: 30rpx;
}

button::after {
  border: none;
}

/* 小屏 */
@media(max-width: 360px) {
  .favorite-text {
    font-size: 28rpx;
  }

  .copy-btn,
  .prompt-btn,
  .delete-btn {
    font-size: 24rpx;
    padding: 0 20rpx;
  }
}