/* pages/favorites/favorites.wxss */

page {
  background: #fefcf7;
}

.container {
  min-height: 100vh;
  background: #fefcf7;
  padding: 30rpx;
}

.title-row {
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.title-actions {
  display: flex;
  justify-content: center;
  gap: 18rpx;
  margin-top: 18rpx;
}

.detail-btn,
.manage-btn {
  width: auto !important;
  min-width: 96rpx;
  height: 48rpx;
  line-height: 48rpx;
  padding: 0 24rpx !important;
  margin: 0 !important;
  font-size: 24rpx;
  font-weight: normal;
  color: #fff;
  background: #8bb1bf;
  border-radius: 24rpx;
}

.manage-btn {
  background: #c9a878;
}

.title-text {
  font-size: 38rpx;
  font-weight: bold;
  color: #222;
}

button::after {
  border: none;
}

.subtitle {
  display: block;
  margin-top: 10rpx;
  text-align: center;
  font-size: 26rpx;
  color: #9a9080;
}

.search-input {
  margin-top: 20rpx;
  height: 70rpx;
  line-height: 70rpx;
  padding: 0 24rpx;
  background: #f5f0e0;
  border-radius: 35rpx;
  font-size: 28rpx;
}

.favorite-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 20rpx;
}

.favorite-card {
  position: relative;
  background: #ffffff;
  border-radius: 22rpx;
  padding: 24rpx;
  box-shadow: 0 6rpx 18rpx rgba(168, 144, 96, .1);
}

.entry-item {
  margin-bottom: 10rpx;
  padding-bottom: 10rpx;
}

.entry-title {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.entry-desc {
  margin-top: 6rpx;
  padding-left: 38rpx;
  font-size: 26rpx;
  color: #666;
}

.entry-category {
  margin-top: 4rpx;
  padding-left: 38rpx;
  font-size: 26rpx;
  color: #a89060;
}

.favorite-actions {
  margin-top: 20rpx;
  display: flex;
  justify-content: flex-end;
  gap: 14rpx;
}

.copy-btn,
.prompt-btn,
.delete-btn {
  height: 42rpx !important;
  line-height: 42rpx !important;
  padding: 0 10rpx !important;
  min-width: 0 !important;
  width: auto !important;
  margin: 0 !important;
  border-radius: 21rpx;
  color: #fff;
  font-size: 26rpx;
  font-weight: bold;
  display: inline-flex !important;
  align-items: center;
  justify-content: center;
}

.copy-btn {
  background: #8bb1bf;
}

.prompt-btn {
  background: #b09cc8;
}

.delete-btn {
  background: #d98f9b;
}

.empty {
  text-align: center;
  margin-top: 200rpx;
  color: #999;
  font-size: 30rpx;
}

.favorite-card.selected {
  background: #eaf2f5;
  box-shadow: 0 0 0 3rpx #8bb1bf;
}

.selection-mark {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 38rpx;
  height: 38rpx;
  line-height: 38rpx;
  text-align: center;
  color: #fff;
  font-size: 26rpx;
  font-weight: bold;
  background: #fff;
  border: 2rpx solid #8bb1bf;
  border-radius: 50%;
}

.favorite-card.selected .selection-mark {
  background: #8bb1bf;
}

.manage-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));
  color: #444;
  background: #fff;
  box-shadow: 0 -6rpx 18rpx rgba(0, 0, 0, .1);
  z-index: 10;
}

.batch-delete-btn {
  margin: 0;
  padding: 0 34rpx;
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 34rpx;
  color: #fff;
  font-size: 28rpx;
  background: #d98f9b;
}
.favorite-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.favorite-index {
  font-size: 26rpx;
  color: #888;
  font-weight: bold;
}

.favorite-time {
  font-size: 24rpx;
  color: #aaa;
}

/* ===== 页面标题图标（主界面同款，48rpx 缩放版） ===== */
.title-with-icon,
.title-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.page-icon {
  width: 48rpx;
  height: 48rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* 历史：时钟（蓝） */
.page-icon.icon-history {
  border: 3rpx solid #6a9fc8;
  border-radius: 50%;
  box-sizing: border-box;
}

.page-icon.icon-history .clock-hand {
  position: absolute;
  background: #6a9fc8;
  border-radius: 2rpx;
}

.page-icon.icon-history .clock-hand-v {
  width: 4rpx;
  height: 14rpx;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -100%);
  transform-origin: bottom center;
}

.page-icon.icon-history .clock-hand-h {
  width: 10rpx;
  height: 4rpx;
  left: 50%;
  top: 50%;
  transform: translateY(-50%);
}

/* 收藏：五角星（黄，空心） */
.page-icon.icon-favorite {
  position: relative;
  background: #e0b848;
  clip-path: polygon(
    50% 0%,
    61% 35%,
    98% 35%,
    68% 57%,
    79% 91%,
    50% 70%,
    21% 91%,
    32% 57%,
    2% 35%,
    39% 35%
  );
}

.page-icon.icon-favorite::after {
  content: '';
  position: absolute;
  inset: 5rpx;
  background: #fdfbf5;
  clip-path: polygon(
    50% 0%,
    61% 35%,
    98% 35%,
    68% 57%,
    79% 91%,
    50% 70%,
    21% 91%,
    32% 57%,
    2% 35%,
    39% 35%
  );
}

/* 词条中心：打开的书（绿） */
.page-icon.icon-entries .book-page {
  position: absolute;
  top: 7rpx;
  width: 19rpx;
  height: 33rpx;
  border: 3rpx solid #6ab88a;
  box-sizing: border-box;
}

.page-icon.icon-entries .book-left {
  left: 4rpx;
  border-right: none;
  border-radius: 5rpx 0 0 5rpx;
  transform: skewY(-4deg);
  transform-origin: right center;
}

.page-icon.icon-entries .book-right {
  right: 4rpx;
  border-left: none;
  border-radius: 0 5rpx 5rpx 0;
  transform: skewY(4deg);
  transform-origin: left center;
}

/* 成就：奖杯（红） */
.page-icon.icon-achievement .trophy-cup {
  position: absolute;
  left: 50%;
  top: 3rpx;
  transform: translateX(-50%);
  width: 28rpx;
  height: 21rpx;
  border: 4rpx solid #d87070;
  border-top: none;
  border-radius: 0 0 12rpx 12rpx;
  box-sizing: border-box;
}

.page-icon.icon-achievement .trophy-cup::before {
  content: '';
  position: absolute;
  left: -8rpx;
  top: 2rpx;
  width: 6rpx;
  height: 10rpx;
  border: 3rpx solid #d87070;
  border-right: none;
  border-radius: 8rpx 0 0 8rpx;
}

.page-icon.icon-achievement .trophy-cup::after {
  content: '';
  position: absolute;
  right: -8rpx;
  top: 2rpx;
  width: 6rpx;
  height: 10rpx;
  border: 3rpx solid #d87070;
  border-left: none;
  border-radius: 0 8rpx 8rpx 0;
}

.page-icon.icon-achievement .trophy-stem {
  position: absolute;
  left: 50%;
  top: 26rpx;
  transform: translateX(-50%);
  width: 6rpx;
  height: 8rpx;
  background: #d87070;
}

.page-icon.icon-achievement .trophy-base {
  position: absolute;
  left: 50%;
  bottom: 4rpx;
  transform: translateX(-50%);
  width: 21rpx;
  height: 6rpx;
  background: #d87070;
  border-radius: 2rpx;
}

/* ===== 主页面同款装饰：云朵 + 四角星 ===== */
page {
  background: linear-gradient(#ffffff, #fefcf7);
}

.container {
  position: relative;
  overflow: hidden;
  background: linear-gradient(#ffffff, #fefcf7);
}

/* 底部云朵：圆 + 底座，横穿屏幕 */
.cloud-bg {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  width: 100vw;
  bottom: -20rpx;
  height: 280rpx;
  z-index: 0;
  pointer-events: none;
}

.cloud-bg-base {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 80rpx;
  background: #f2ead9;
}

.cb {
  position: absolute;
  background: #f2ead9;
  border-radius: 50%;
  bottom: 0;
}

/* 四角星装饰（菱形芒星） */
.sparkle-deco {
  position: absolute;
  z-index: 2;
  clip-path: polygon(
    50% 0%,
    65% 35%,
    100% 50%,
    65% 65%,
    50% 100%,
    35% 65%,
    0% 50%,
    35% 35%
  );
  animation: sparkle-float 3s ease-in-out infinite;
}
/* 随机四角星装饰（页面级） */
.page-sparkles {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 0;
  overflow: hidden;
}


@keyframes sparkle-float {
  0%, 100% {
    transform: translateY(0) rotate(0deg);
    opacity: 0.85;
  }
  50% {
    transform: translateY(-10rpx) rotate(15deg);
    opacity: 1;
  }
}

/* 内容浮在云朵之上 */
.title,
.title-row,
.header,
.intro {
  position: relative;
  z-index: 2;
}

.favorite-list {
  position: relative;
  z-index: 1;
}
