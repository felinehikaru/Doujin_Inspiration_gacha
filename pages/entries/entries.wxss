/* pages/entries/entries.wxss */

/* 页面整体 */
.container {
  min-height: 100vh;
  padding: 30rpx;
  box-sizing: border-box;
  background: #f8f5ff;
}

/* 标题 */
.title {
  text-align: center;
  margin-bottom: 30rpx;
}

.title-text {
  display: block;
  font-size: 42rpx;
  font-weight: bold;
  color: #333;
}

.subtitle {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #888;
}

/* 顶部按钮 */
.main-btn {
  width: 70%;
  margin: 18rpx auto;
  border-radius: 18rpx;
  background: white;
  color: #333;
  font-size: 30rpx;
}

/* 搜索框 */
.search {
  width: 100%;
  height: 80rpx;
  background: white;
  border-radius: 20rpx;
  padding: 0 25rpx;
  box-sizing: border-box;
  margin: 30rpx 0;
  font-size: 28rpx;
}

/* 六分类标签 */
.tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-bottom: 25rpx;
}

.tab {
  padding: 14rpx 25rpx;
  background: #ffffff;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #555;
}

.tab.active {
  background: #8b5cf6;
  color: white;
}

/* 当前分类标题 */
.current-title {
  font-size: 34rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

/* 词条列表 */
.entry-list {
  width: 100%;
}

.entry-card {
  background: white;
  border-radius: 16rpx;
  padding: 14rpx 18rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 3rpx 8rpx rgba(0, 0, 0, 0.05);
}

.entry-name {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #222;
  line-height: 1.2;
}

.entry-desc {
  display: block;
  margin-top: 5rpx;
  font-size: 25rpx;
  color: #666;
  line-height: 1.35;
}

.empty {
  text-align: center;
  color: #999;
  padding: 80rpx 0;
}

/* 投稿弹窗 */
.modal {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  justify-content: center;
  align-items: center;
}

.modal-box {
  width: 82%;
  max-height: 85vh;
  overflow-y: auto;
  background: white;
  border-radius: 30rpx;
  padding: 40rpx;
  box-sizing: border-box;
}

.modal-title {
  display: block;
  text-align: center;
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
}

/* 投稿输入 */
.upload-input {
  width: 100%;
  height: 80rpx;
  background: #f5f5f5;
  border-radius: 15rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  margin-bottom: 20rpx;
  font-size: 28rpx;
}

.upload-textarea {
  width: 100%;
  min-height: 260rpx;
  background: #f5f5f5;
  border-radius: 15rpx;
  padding: 20rpx;
  box-sizing: border-box;
  margin-bottom: 20rpx;
  font-size: 28rpx;
}

/* 分类选择 */
.picker {
  height: 80rpx;
  line-height: 80rpx;
  background: #f5f5f5;
  border-radius: 15rpx;
  padding: 0 20rpx;
  margin-bottom: 20rpx;
  color: #555;
}

/* 标签输入 */
.upload-input:last-of-type {
  margin-bottom: 30rpx;
}

/* 弹窗按钮 */
.submit-btn {
  background: #8b5cf6;
  color: white;
  border-radius: 20rpx;
  margin-top: 20rpx;
}

.cancel-btn {
  margin-top: 15rpx;
  border-radius: 20rpx;
}

.loading-tip{
  text-align:center;
  color:#999;
  padding:30rpx;
 }

 .entry-area{
  position:relative;
  z-index:1;
}

.modal {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  justify-content: center;
  align-items: center;
}

/* =====================
   投稿重复检测提示
===================== */

.similar-box {
  background: #fff7ed;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.similar-title {
  display: block;
  color: #d97706;
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 15rpx;
}

.similar-item {
  background: white;
  border-radius: 15rpx;
  padding: 15rpx;
  margin-top: 10rpx;
}

.similar-name {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.similar-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}