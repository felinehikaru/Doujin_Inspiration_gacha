/* pages/entries/entries.wxss */

/* 页面整体 */
.container {
  min-height: 100vh;
  padding: 30rpx;
  box-sizing: border-box;
  background: #f8f5ff;
}

/* 标题 */
.title {
  text-align: center;
  margin-bottom: 30rpx;
}

.title-text {
  display: block;
  font-size: 42rpx;
  font-weight: bold;
  color: #333;
}

.subtitle {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #888;
}

/* 顶部按钮 */
.main-btn {
  width: 70%;
  margin: 18rpx auto;
  border-radius: 18rpx;
  background: white;
  color: #333;
  font-size: 30rpx;
}

/* 搜索框 */
.search {
  width: 100%;
  height: 80rpx;
  background: white;
  border-radius: 20rpx;
  padding: 0 25rpx;
  box-sizing: border-box;
  margin: 30rpx 0;
  font-size: 28rpx;
}

/* 六分类标签 */
.tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-bottom: 25rpx;
}

.tab {
  padding: 14rpx 25rpx;
  background: #ffffff;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #555;
}

.tab.active {
  background: #8b5cf6;
  color: white;
}

/* 当前分类标题 */
.current-title {
  font-size: 34rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

/* 词条列表 */
.entry-list {
  width: 100%;
}

.entry-card {
  background: white;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.08);
}

.entry-name {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #222;
}

.entry-desc {
  display: block;
  margin-top: 15rpx;
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

.empty {
  text-align: center;
  color: #999;
  padding: 80rpx 0;
}

/* 投稿弹窗 */
.modal {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  justify-content: center;
  align-items: center;
}

.modal-box {
  width: 82%;
  background: white;
  border-radius: 30rpx;
  padding: 40rpx;
  box-sizing: border-box;
}

.modal-title {
  display: block;
  text-align: center;
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
}

/* 投稿输入 */
.upload-input {
  width: 100%;
  height: 80rpx;
  background: #f5f5f5;
  border-radius: 15rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  margin-bottom: 20rpx;
  font-size: 28rpx;
}

.upload-textarea {
  width: 100%;
  min-height: 260rpx;
  background: #f5f5f5;
  border-radius: 15rpx;
  padding: 20rpx;
  box-sizing: border-box;
  margin-bottom: 20rpx;
  font-size: 28rpx;
}

/* 分类选择 */
.picker {
  height: 80rpx;
  line-height: 80rpx;
  background: #f5f5f5;
  border-radius: 15rpx;
  padding: 0 20rpx;
  margin-bottom: 20rpx;
  color: #555;
}

/* 标签输入 */
.upload-input:last-of-type {
  margin-bottom: 30rpx;
}

/* 弹窗按钮 */
.submit-btn {
  background: #8b5cf6;
  color: white;
  border-radius: 20rpx;
  margin-top: 20rpx;
}

.cancel-btn {
  margin-top: 15rpx;
  border-radius: 20rpx;
}

.loading-tip{
  text-align:center;
  color:#999;
  padding:30rpx;
 }