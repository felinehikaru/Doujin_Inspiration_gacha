<view class="container">
  <!-- 底部云朵装饰 -->
  <view class="cloud-bg">
    <view class="cloud-bg-base"></view>
    <view class="cb" style="left:2%; width:160rpx; height:160rpx;"></view>
    <view class="cb" style="left:14%; width:240rpx; height:240rpx;"></view>
    <view class="cb" style="left:36%; width:130rpx; height:130rpx;"></view>
    <view class="cb" style="left:55%; width:220rpx; height:220rpx;"></view>
    <view class="cb" style="left:76%; width:170rpx; height:170rpx;"></view>
    <view class="cb" style="left:90%; width:110rpx; height:110rpx;"></view>
  </view>

  <!-- 随机四角星装饰（每次打开随机生成） -->
  <view class="page-sparkles">
    <view
      wx:for="{{sparkles}}"
      wx:key="index"
      class="sparkle-deco"
      style="left:{{item.x}}rpx;top:{{item.y}}rpx;width:{{item.size}}rpx;height:{{item.size}}rpx;background:{{item.color}};animation-delay:{{item.delay}}s;"
    ></view>
  </view>



  <!-- 标题 -->
  <view class="title">
    <view class="title-with-icon">
      <view class="page-icon icon-entries">
        <view class="book-page book-left"></view>
        <view class="book-page book-right"></view>
      </view>
      <text class="title-text">词条中心</text>
    </view>
    <text class="subtitle">浏览与投稿创作灵感</text>
  </view>

  <!-- 功能按钮 -->
  <button class="main-btn btn-upload" bindtap="openUpload">
 投稿新词条
  </button>

  <button class="main-btn btn-view" bindtap="loadEntries">
查看全部词条
  </button>

  <button wx:if="{{role==='admin'||role==='maintainer'}}" class="main-btn btn-audit" bindtap="goAudit">
词条审核
  </button>

  <!-- 浏览区域 -->
  <view wx:if="{{showList}}" class="entry-area">
    <!-- 搜索 -->
    <view class="search-wrap">
      <text class="search-icon">🔍</text>
      <input class="search" placeholder="搜索词条" bindinput="onSearch" />
    </view>

    <!-- 搜索结果 -->
    <view wx:if="{{isSearching}}">
      <view wx:for="{{searchGroups}}" wx:key="category" class="search-group">
        <view class="category-title">
          <view class="cat-dot"></view>
          {{item.title}}
        </view>

        <view wx:for="{{item.list}}" wx:key="_id" class="entry-card">
          <text class="entry-name">{{item.text}}</text>
          <text class="entry-desc">{{item.desc}}</text>
          <view wx:if="{{item.tags && item.tags.length}}" class="entry-tags">
            <text class="entry-tag-line">tag：<text wx:for="{{item.tags}}" wx:key="*this" wx:for-item="t">{{t}}　</text></text>
          </view>
        </view>
      </view>
    </view>

    <!-- 正常浏览 -->
    <view wx:else>
      <!-- 六分类标签 -->
      <view class="tabs">
        <view wx:for="{{categoryList}}" wx:key="category" class="tab {{currentCategory===item.category?'active':''}}" data-category="{{item.category}}" bindtap="changeCategory">
          {{item.title}}
        </view>
      </view>

      <!-- 当前分类 -->
      <view class="entry-list">
        <view wx:if="{{!currentList.length}}" class="empty-tip">
          暂无词条
        </view>

        <view wx:for="{{currentList}}" wx:key="_id" class="entry-card">
          <text class="entry-name">{{item.text}}</text>
          <text class="entry-desc">{{item.desc}}</text>
          <view wx:if="{{item.tags && item.tags.length}}" class="entry-tags">
            <text class="entry-tag-line">tag：<text wx:for="{{item.tags}}" wx:key="*this" wx:for-item="t">{{t}}　</text></text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 投稿弹窗 -->
  <view wx:if="{{showUpload}}" class="modal">
    <view class="modal-box">
      <text class="modal-title">
        投稿新词条
      </text>

      <input class="upload-input" 
      placeholder="词条名称" 
      maxlength="30" 
      bindinput="onTextInput" />

      <!-- 相似词条检测 -->

      <view wx:if="{{showSimilar}}" class="similar-box">
        <text class="similar-title">⚠️ 发现相似词条，请确认</text>

        <view wx:for="{{similarEntries}}" 
        wx:key="_id" 
        class="similar-item" 
        data-index="{{index}}" 
        bindtap="chooseSimilar">

          <text class="similar-name">{{item.text}}</text>
          <text class="similar-desc">{{item.desc}}</text>
        </view>
      </view>

      <textarea 
      class="upload-textarea" 
      placeholder="词条描述" 
      maxlength="300" 
      bindinput="onDescInput" />

      <picker 
      mode="selector" 
      range="{{categoryOptions}}" 
      range-key="label" 
      bindchange="onCategoryChange">
      
        <view class="picker">
          {{uploadCategoryLabel||"请选择分类"}}
        </view>
      </picker>

      <input class="upload-input" placeholder="标签（逗号分隔）" value="{{uploadTags}}" bindinput="onTagsInput" />

      <!-- 相似 tag 推荐 -->
      <view wx:if="{{tagSuggestions.length}}" class="tag-suggest">
        <view
          wx:for="{{tagSuggestions}}"
          wx:key="*this"
          class="tag-suggest-item"
          data-tag="{{item}}"
          bindtap="chooseTag"
        >{{item}}</view>
      </view>

      <button class="submit-btn" bindtap="submitEntry">
        提交审核
      </button>

      <button class="cancel-btn" bindtap="closeUpload">
        取消
      </button>
    </view>
  </view>
</view>