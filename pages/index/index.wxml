<!-- pages/index/index.wxml -->

<view class="container">
  <!-- 左上角帮助 -->
  <view class="help-btn" bindtap="openHelp">
    <text class="help-icon">?</text>
  </view>

  <!-- 标题 -->
  <view class="title">
    <text class="title-text">🎲 同人梗扭蛋机</text>
    <text class="subtitle">摇出你的故事灵感</text>
  </view>

  <!-- 登录入口 -->
  <button class="login-btn" bindtap="goLogin">
    👤 用户中心
  </button>

  <!-- 登录状态 -->
  <view wx:if="{{role!=='visitor'}}" class="role-text">
    当前身份：{{role}}
  </view>

  <!-- 扭蛋机主体 -->
  <view class="gacha-machine {{isShaking?'shaking':''}}">
    <!-- 外部光晕 -->
    <view class="machine-light"></view>

    <view class="gacha-area">
      <!-- 玻璃球罩 -->
      <view class="dome">
        <view wx:for="{{balls}}" wx:key="index" class="ball" style="width:{{item.size}}rpx; height:{{item.size}}rpx; left:{{item.left}}%; top:{{item.top}}%; background:{{item.color}};">
        </view>
      </view>

      <!-- 机器底座 -->
      <view class="body">
        <text class="brand">灵感扭蛋</text>
        <!-- 旋钮 -->
        <view class="knob"></view>
        <!-- 出口 -->
        <view class="slot"></view>
      </view>
    </view>
  </view>

  <!-- 模式显示 -->
  <view class="mode-display">
    <text class="mode-name">{{modeName}}</text>
    <text class="mode-badge">{{modeBadge}}</text>
  </view>

  <!-- 抽卡按钮 -->
  <view class="controls">
    <view class="btn-group">
      <button class="btn btn-random" bindtap="spinRandom">完全随机</button>
      <button class="btn btn-balanced" bindtap="spinBalanced">营养平衡</button>
    </view>
  </view>

  <!-- 抽卡结果 -->
  <view class="result-area" wx:if="{{results.length}}">
    <view class="result-card" wx:for="{{results}}" wx:key="index">
      <text class="result-title">{{item.text}}</text>
      <text class="result-category">分类：{{item.category}}</text>
      <text class="result-desc">{{item.desc}}</text>
      <text class="result-tags">标签：{{item.tags.join("、")}}</text>
    </view>
  </view>

  <!-- 当前结果操作 -->
  <view class="action-area" wx:if="{{results.length}}">

    <button class="btn btn-collect" bindtap="collectCurrent">
      ⭐ 收藏
    </button>

    <button class="btn btn-prompt" bindtap="goToPrompt">
      提示词模板
    </button>

    <button class="btn btn-share" bindtap="openSharePanel">
      分享结果
    </button>

  </view>

  <!-- 底部入口 -->
  <view class="record-entry">
    <button class="record-btn history-btn" bindtap="openHistory">📜 历史</button>
    <button class="record-btn favorite-btn" bindtap="openFavorites">⭐ 我的</button>
    <button class="record-btn entries-btn" bindtap="openEntries">📚 词条</button>
  </view>

  <!-- 帮助弹窗 -->
  <view wx:if="{{showHelpModal}}" class="help-modal">
    <view class="help-modal-content">
      <text class="help-modal-title">使用说明</text>

      <view class="help-modal-body">
        <text class="help-line">1. 点击抽卡按钮获得三个灵感词条</text>
        <text class="help-line">2. 平衡模式从六个分类中抽取</text>
        <text class="help-line">3. 提示词模板可自行编辑复制</text>
      </view>

      <view class="help-modal-footer">
        <button class="btn btn-ghost" bindtap="closeHelp">知道了</button>
      </view>
    </view>
  </view>
</view>

<!-- 分享选择 -->
<view wx:if="{{showSharePanel}}" class="help-modal">
  <view class="help-modal-content">
   
    <text class="help-modal-title">分享扭蛋结果</text>

    <button class="btn btn-share" bindtap="copyShareText">
      文字分享
    </button>

    <button class="btn btn-share" bindtap="createShareImage">
      图片分享（待开发）
    </button>

    <button class="btn btn-ghost" bindtap="closeSharePanel">
      取消
    </button>
  </view>
</view>

<!-- 分享引导 -->
<view class="share-guide">
  <text class="share-arrow">↑</text>
  <text class="share-text">分享</text>
</view>