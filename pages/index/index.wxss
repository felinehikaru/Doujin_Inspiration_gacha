/* =================================
 pages/index/index.wxss
 同人梗扭蛋机 主页面 V3.0
 暗夜莫兰迪风
================================ */

/* =====================
 页面基础
===================== */
page {
  background: #000;
  min-height: 100vh;
}

.container {
  min-height: 100vh;
  padding: 40rpx 30rpx 60rpx;
  background: #000;
  box-sizing: border-box;
}

/* =====================
 标题
===================== */
.title {
  text-align: center;
  margin-top: 40rpx;
  margin-bottom: 25rpx;
}

.title-text {
  display: block;
  font-size: 48rpx;
  font-weight: 900;
  color: #f5f1ea;
  letter-spacing: 2rpx;
}

.subtitle {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #aaa4a0;
}

/* =====================
帮助按钮
===================== */
.help-btn {
  position: fixed;
  top: 35rpx;
  left: 30rpx;
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  background: #3a3940;
  border: 2rpx solid #777;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.help-icon {
  color: #fff;
  font-size: 38rpx;
  font-weight: bold;
}

/* =====================
登录按钮
===================== */
.login-btn {
  width: 220rpx;
  height: 70rpx;
  line-height: 70rpx;
  margin: 20rpx auto;
  background: #e8dfd4;
  color: #333;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: bold;
}

.role-text {
  text-align: center;
  color: #aaa;
  font-size: 24rpx;
}

/* =====================
扭蛋区域
===================== */
.gacha-machine {
  position: relative;
}

.gacha-machine.shaking {
  animation: shake .15s linear infinite;
}

.gacha-area {
  position: relative;
  width: 100%;
  height: 560rpx;
  margin: 20rpx auto;
}

.machine-light {
  position: absolute;
  width: 500rpx;
  height: 500rpx;
  left: 50%;
  top: 20rpx;
  transform: translateX(-50%);
  border-radius: 50%;
  background: radial-gradient(
    circle,
    rgba(170, 150, 200, .2),
    transparent 70%
  );
}

/* =====================
玻璃罩
===================== */
.dome {
  position: absolute;
  top: 20rpx;
  left: 50%;
  width: 86%;
  height: 68%;
  transform: translateX(-50%);
  border-radius: 50%;
  background: radial-gradient(
    circle at 35% 25%,
    rgba(255, 255, 255, .45),
    rgba(120, 130, 150, .2)
  );
  border: 3rpx solid rgba(255, 255, 255, .4);
  box-shadow:
    inset 0 0 50rpx rgba(255, 255, 255, .15),
    0 20rpx 50rpx rgba(0, 0, 0, .8);
  overflow: hidden;
}

/*玻璃高光*/
.dome::after {
  content: "";
  position: absolute;
  width: 180rpx;
  height: 100rpx;
  top: 50rpx;
  left: 80rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, .25);
  filter: blur(10rpx);
}

/* =====================
球
===================== */
.ball {
  position: absolute;
  border-radius: 50%;
  box-shadow:
    inset -8rpx -8rpx 15rpx rgba(0, 0, 0, .25),
    inset 5rpx 5rpx 15rpx rgba(255, 255, 255, .35);
}

/* =====================
机器底座
===================== */
.body {
  position: absolute;
  bottom: 20rpx;
  left: 50%;
  width: 78%;
  height: 32%;
  transform: translateX(-50%);
  background: linear-gradient(
    180deg,
    #d58b8b,
    #d9b39b
  );
  border-radius: 30rpx;
  box-shadow: 0 15rpx 40rpx rgba(0, 0, 0, .6);
}

.brand {
  position: absolute;
  top: 18rpx;
  width: 100%;
  text-align: center;
  color: #fff;
  font-size: 34rpx;
  font-weight: bold;
}

.knob {
  position: absolute;
  top: 90rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 75rpx;
  height: 75rpx;
  border-radius: 50%;
  background: linear-gradient(
    145deg,
    #8896b8,
    #c8a6a6
  );
}

.slot {
  position: absolute;
  bottom: 30rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 55%;
  height: 45rpx;
  background: #33333b;
  border-radius: 15rpx;
}

/* =====================
模式
===================== */
.mode-display {
  text-align: center;
  color: #aaa;
  font-size: 24rpx;
}

.mode-name {
  color: #fff;
  font-weight: bold;
}

.mode-badge {
  margin-left: 10rpx;
  padding: 5rpx 20rpx;
  border-radius: 30rpx;
  background: #444;
  color: #ddd;
}

/* =====================
抽卡按钮
===================== */
.controls {
  margin-top: 25rpx;
}

.btn-group {
  display: flex;
  gap: 18rpx;
}

.btn{
  flex:1;
  height:82rpx;
  line-height:82rpx;
  border-radius:45rpx;
  border:none;
  font-size:28rpx;
  font-weight:bold;
  color:#333;
}

.btn-random {
  background: linear-gradient(
    135deg,
    #9b8fd8,
    #d98ca3
  );
}

.btn-balanced {
  background: linear-gradient(
    135deg,
    #8faeae,
    #b7a6c9
  );
}

/* =====================
结果
===================== */
.result-area {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 25rpx;
}

.result-card {
  background: #fff;
  border-radius: 18rpx;
  padding: 18rpx;
}

.result-title {
  color: #333;
  font-size: 28rpx;
  font-weight: bold;
}

.result-desc,
.result-category,
.result-tags {
  display: block;
  color: #666;
  font-size: 22rpx;
  margin-top: 8rpx;
}

/* =====================
操作按钮
===================== */
.action-area {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.btn-collect {
  background: #b98b8b;
}

.btn-prompt {
  background: #9180b8;
}

/* =====================
底部入口
===================== */
.record-entry {
  display: flex;
  gap: 18rpx;
  margin-top: 30rpx;
}

.record-btn {
  flex: 1;
  height: 70rpx;
  line-height: 70rpx;
  border-radius: 40rpx;
  font-size: 24rpx;
  font-weight: bold;
}

.history-btn {
  background: #ded6e8;
  color: #554d60;
}

.favorite-btn {
  background: #e8d8a8;
  color: #69572c;
}

.entries-btn {
  background: #ddd;
  color: #444;
}

/* =====================
弹窗
===================== */
.help-modal {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, .6);
  display: flex;
  justify-content: center;
  align-items: center;
}

.help-modal-content {
  width: 80%;
  background: #fff;
  border-radius: 30rpx;
  padding: 40rpx;
}

/* =====================
动画
===================== */
@keyframes shake {
  0% {
    transform: rotate(0);
  }
  50% {
    transform: rotate(3deg);
  }
  100% {
    transform: rotate(-3deg);
  }
}

/*隐藏残余横杠*/
.mode-display::before,
.mode-display::after {
  display: none;
  content: none;
}

button::after {
  border: none;
}

/* 小屏 */
@media(max-width: 420px) {
  .title-text {
    font-size: 42rpx;
  }

  .gacha-area {
    height: 520rpx;
  }

  .result-area {
    grid-template-columns: 1fr;
  }
}

/* =====================
   分享引导
===================== */

.share-guide {
  position: fixed;
  top: 20rpx;
  right: 90rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 998;
}

.share-arrow {
  font-size: 42rpx;
  font-weight: 900;
  color: #ffffff;
  line-height: 40rpx;
}

.share-text {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #ffffff;
  font-weight: 700;
}

/* =====================
结果操作按钮文字优化
===================== */

.action-area .btn {
  color:#2d2633;
  font-weight:900;
}

/* 收藏 */
.btn-collect {
  background:#c99b9b;
  color:#3b2525 !important;
}

/* 提示词 */
.btn-prompt {
  background:#a99bd0;
  color:#302344 !important;
}

/* 分享结果 */
.btn-share {
  background:#9eb8b8;
  color:#203333 !important;
}

.btn-share{
  background:#9eb8b8;
  color:#203333!important;
 }
 
 .btn-ghost{
  background:#999;
  color:#fff!important;
 }