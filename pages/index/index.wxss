.cf-2  { width: 12rpx; height: 12rpx; background: #e8c97a; animation-delay: 0.07s; animation-name: cf2-fly; }
.cf-3  { width: 14rpx; height: 14rpx; background: #8bb1cf; animation-delay: 0.12s; animation-name: cf3-fly; }
.cf-4  { width: 12rpx; height: 12rpx; background: #c9bfe8; animation-delay: 0.05s; animation-name: cf4-fly; }
.cf-5  { width: 15rpx; height: 15rpx; background: #e8c97a; animation-delay: 0.15s; animation-name: cf5-fly; }
.cf-6  { width: 13rpx; height: 13rpx; background: #d87070; animation-delay: 0.1s;  animation-name: cf6-fly; }
.cf-7  { width: 12rpx; height: 12rpx; background: #8bb1cf; animation-delay: 0.2s;  animation-name: cf7-fly; }
.cf-8  { width: 15rpx; height: 15rpx; background: #d87070; animation-delay: 0.18s; animation-name: cf8-fly; }
