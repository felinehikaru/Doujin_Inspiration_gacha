/* =====================
   动画（机器微微摇动，球在罩内弹跳）
===================== */

.shaking {
  transform-origin: center 88%;   /* 摇动中心轴在出口下方 */
  animation: shake 0.9s cubic-bezier(0.36, 0.07, 0.19, 0.97);
}

@keyframes shake {
  0% {
    transform: rotate(0);
  }
  18% {
    transform: rotate(-1.4deg);
  }
  36% {
    transform: rotate(1.4deg);
  }
  54% {
    transform: rotate(-1deg);
  }
  72% {
    transform: rotate(0.8deg);
  }
  88% {
    transform: rotate(-0.4deg);
  }
  100% {
    transform: rotate(0);
  }
}

/* 摇动时，罩内球上下弹跳晃动（立体感；用固定关键帧值，兼容安卓 WebView 内核） */

.shaking .ball {
  animation: ball-bounce 1.1s ease-in-out infinite;
}

@keyframes ball-bounce {
  0%, 100% {
    transform: translate(-50%, -50%) translate(0, 0) rotate(0deg) scale(1);
  }
  30% {
    transform: translate(-50%, -50%) translate(2rpx, -11rpx) rotate(1.2deg) scale(1.05);
  }
  55% {
    transform: translate(-50%, -50%) translate(-1rpx, -2rpx) rotate(-0.6deg) scale(1.02);
  }
  80% {
    transform: translate(-50%, -50%) translate(1rpx, 5rpx) rotate(0.8deg) scale(0.97);
  }
}

/* =====================
   扭蛋群（位于玻璃罩内）
===================== */

.balls-layer {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 1;          /* 在玻璃罩图片下方（z-index:2），在机身（z-index:3）下方，但在背景之上 */
  pointer-events: none; /* 避免干扰按钮点击 */
}

.ball {
  position: absolute;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  /* 容器只做定位和尺寸，内容由子元素绘制 */
  overflow: hidden; /* 保证子元素不溢出圆角 */
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.15); /* 外部阴影增加立体感 */
}

/* 球体颜色层：占满父容器 */
.ball-body {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.ball {
  position: absolute;
  border-radius: 50%;
  background: radial-gradient(circle at 30% 30%, 
    rgba(255,255,255,0.9) 0%, 
    var(--ball-color, #f0a8c0) 50%, 
    var(--ball-color, #f0a8c0) 75%,
    rgba(0,0,0,0.2) 100%
  );
  box-shadow: 
    inset -2rpx -2rpx 8rpx rgba(0,0,0,0.25),
    inset 2rpx 2rpx 8rpx rgba(255,255,255,0.5),
    0 3rpx 10rpx rgba(0,0,0,0.15);
  transform: translate(-50%, -50%);
}

