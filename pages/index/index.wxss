/* 飞行动画期间：成就入口隐藏，落座后解除（弹入动画） */
.nav-achievement.ach-fly-lock {
  opacity: 0;
  animation: none;
}

/* ===== 成就入口解锁飞行动画 ===== */
.ach-fly-layer {
  position: fixed;
  left: 50%;
  top: 36%;
  width: 180rpx;
  height: 150rpx;
  margin-left: -90rpx;
  margin-top: -75rpx;
  z-index: 999;
  pointer-events: none;
  /* 位移用 CSS transition 驱动（内联 transform，无 CSS 变量，安卓/iOS 兼容）；
     JS 先置 0/0 渲染，再 setData 目标位置触发飞行 */
  transition: transform 2.1s cubic-bezier(0.33, 0.1, 0.25, 1);
}

/* 飞行的成就按钮：复用底部入口样式，固定尺寸并取消弹入动画 */
.ach-fly-btn {
  width: 180rpx;
  height: 150rpx;
  flex: none;
  box-sizing: border-box;
  animation: none;
  box-shadow: 0 10rpx 30rpx rgba(216, 112, 112, 0.3);
}
/* 闪光光晕 */
.ach-fly-halo {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 210rpx;
  height: 210rpx;
  margin: -105rpx 0 0 -105rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 232, 150, 0.9) 0%, rgba(255, 214, 120, 0.4) 40%, rgba(255, 205, 100, 0) 72%);
  opacity: 0;
  animation: ach-halo-burst 1.7s ease-out forwards;
}
@keyframes ach-halo-burst {
  0%   { transform: scale(0.25); opacity: 0; }
  18%  { opacity: 0.95; }
  100% { transform: scale(1.7); opacity: 0; }
}

/* 小彩带粒子 */
.ach-fly-confetti {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 0;
  height: 0;
}
.acf {
  position: absolute;
  left: 0;
  top: 0;
  width: 14rpx;
  height: 7rpx;
  border-radius: 3rpx;
  opacity: 0;
  animation-duration: 1.5s;
  animation-timing-function: ease-out;
  animation-fill-mode: forwards;
}
.acf-1  { background: #f0b888; animation-name: acf-fly-1;  animation-delay: .05s; }
.acf-2  { background: #d87070; animation-name: acf-fly-2;  animation-delay: .12s; }
.acf-3  { background: #e8d5a3; animation-name: acf-fly-3;  animation-delay: .18s; }
.acf-4  { background: #f0a8c0; animation-name: acf-fly-4;  animation-delay: .24s; }
.acf-5  { background: #8fc4e8; animation-name: acf-fly-5;  animation-delay: .10s; }
.acf-6  { background: #a8d8a0; animation-name: acf-fly-6;  animation-delay: .16s; }
.acf-7  { background: #c8a8e8; animation-name: acf-fly-7;  animation-delay: .22s; }
.acf-8  { background: #f0b888; animation-name: acf-fly-8;  animation-delay: .28s; }
.acf-9  { background: #e8d5a3; animation-name: acf-fly-9;  animation-delay: .08s; }
.acf-10 { background: #d87070; animation-name: acf-fly-10; animation-delay: .14s; }
@keyframes acf-fly-1  { 0% { transform: translate(0,0) rotate(0deg) scale(1); opacity: 1; } 100% { transform: translate(150rpx, -70rpx) rotate(300deg) scale(0.5); opacity: 0; } }
@keyframes acf-fly-2  { 0% { transform: translate(0,0) rotate(0deg) scale(1); opacity: 1; } 100% { transform: translate(190rpx, 20rpx) rotate(30deg) scale(0.5); opacity: 0; } }
@keyframes acf-fly-3  { 0% { transform: translate(0,0) rotate(0deg) scale(1); opacity: 1; } 100% { transform: translate(120rpx, 120rpx) rotate(70deg) scale(0.5); opacity: 0; } }
@keyframes acf-fly-4  { 0% { transform: translate(0,0) rotate(0deg) scale(1); opacity: 1; } 100% { transform: translate(40rpx, 180rpx) rotate(110deg) scale(0.5); opacity: 0; } }
@keyframes acf-fly-5  { 0% { transform: translate(0,0) rotate(0deg) scale(1); opacity: 1; } 100% { transform: translate(-70rpx, 150rpx) rotate(150deg) scale(0.5); opacity: 0; } }
@keyframes acf-fly-6  { 0% { transform: translate(0,0) rotate(0deg) scale(1); opacity: 1; } 100% { transform: translate(-150rpx, 90rpx) rotate(190deg) scale(0.5); opacity: 0; } }
@keyframes acf-fly-7  { 0% { transform: translate(0,0) rotate(0deg) scale(1); opacity: 1; } 100% { transform: translate(-190rpx, -30rpx) rotate(230deg) scale(0.5); opacity: 0; } }
@keyframes acf-fly-8  { 0% { transform: translate(0,0) rotate(0deg) scale(1); opacity: 1; } 100% { transform: translate(-120rpx, -120rpx) rotate(270deg) scale(0.5); opacity: 0; } }
@keyframes acf-fly-9  { 0% { transform: translate(0,0) rotate(0deg) scale(1); opacity: 1; } 100% { transform: translate(-40rpx, -180rpx) rotate(310deg) scale(0.5); opacity: 0; } }
@keyframes acf-fly-10 { 0% { transform: translate(0,0) rotate(0deg) scale(1); opacity: 1; } 100% { transform: translate(70rpx, -160rpx) rotate(345deg) scale(0.5); opacity: 0; } }

/* 飞行按钮的图标与文字：保持与底部入口一致的比例 */
