/* =====================
   扭蛋机区域
===================== */

.gacha-machine {
  position: relative;
  width: 600rpx;
  height: 650rpx;
  margin: 16rpx auto 0;
  flex: none;
  z-index: 1;
}

/* 可摇动机器主体（云朵/星星在core外，不随摇动） */

.machine-core {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

/* ---- 四角星装饰（球罩周围，菱形芒星） ---- */

.sparkle-deco {
  position: absolute;
  z-index: 4;
  clip-path: polygon(
    50% 0%,
    65% 35%,
    100% 50%,
    65% 65%,
    50% 100%,
    35% 65%,
    0% 50%,
    35% 35%
  );
  animation: sparkle-float 3s ease-in-out infinite;
}

@keyframes sparkle-float {
  0%, 100% {
    opacity: 0.5;
    transform: scale(0.85);
  }
  50% {
    opacity: 1;
    transform: scale(1.1);
  }
}

/* ---- 玻璃罩 ---- */

.machine-head {
  position: absolute;
  top: 0;
  left: 57rpx;
  width: 486rpx;
  height: 393rpx;
  z-index: 2;
  /* 注意：不可加 filter（saturate/brightness）——安卓 WebView 上
     子节点 filter 会导致父节点 transform 动画（抽卡摇动）不渲染 */
}

/* ---- 机身 ---- */

.machine-body {
  position: absolute;
  left: 77rpx;
  bottom: 10rpx;
  width: 445rpx;
  height: 326rpx;
  z-index: 3;
  /* 同 machine-head：不加 filter，保证抽卡摇动动画在安卓真机正常渲染 */
}

/* =====================
   光效画布（z4：机身之上、金球之下）
===================== */

.gacha-fx-canvas {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  /* z-index 必须在机身(3)/玻璃罩(2)之上，否则真机上金球/光效被机身遮挡不显示 */
  z-index: 8;
  pointer-events: none;
}

/* =====================
   DOM 金球掉落 + 光效（真机 canvas 不可用时的兜底动画）
   出球口坐标：machine-core 内 300rpx 水平中心 / 537rpx 出球口
   ===================== */

.drop-fx {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 5;
  pointer-events: none;
}

/* 白金大光晕（球后，先扩散后逸散消失） */
.drop-glow-a {
  position: absolute;
  left: 50%;
  top: 537rpx;
  width: 340rpx;
  height: 340rpx;
  margin-left: -170rpx;
  margin-top: -170rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255,252,235,0.9) 0%, rgba(255,240,190,0.5) 28%, rgba(255,228,160,0.16) 58%, rgba(255,228,160,0) 74%);
  filter: blur(8rpx);
  opacity: 0;
  animation: drop-glow-a 1.5s ease-out forwards;
}
@keyframes drop-glow-a {
  0% { transform: scale(0.2); opacity: 0; }
  14% { opacity: 1; }
  100% { transform: scale(1.45); opacity: 0; }
}

/* 三条光柱：根部白色渐变、边缘模糊，从出球口向上放射 */
.drop-rays {
  position: absolute;
  left: 50%;
  top: 537rpx;
  width: 0;
  height: 0;
}
.ray {
  position: absolute;
  width: 14rpx;
  height: 210rpx;
  left: -7rpx;
  top: -210rpx;
  background: linear-gradient(180deg, rgba(255,255,255,0.95) 0%, rgba(255,240,190,0.55) 40%, rgba(255,220,150,0) 100%);
  filter: blur(4rpx);
  opacity: 0;
  transform-origin: 50% 100%;
  animation: ray-spread 1.4s ease-out forwards;
}
.ray-1 { transform: rotate(-30deg); animation-delay: 0.06s; }
.ray-2 { transform: rotate(0deg); animation-delay: 0s; }
.ray-3 { transform: rotate(30deg); animation-delay: 0.06s; }
@keyframes ray-spread {
  0% { transform: scaleY(0.3); opacity: 0; }
  18% { opacity: 0.9; }
  100% { transform: scaleY(1.15); opacity: 0; }
}

/* 浓金光晕（金球裂开后跟随两半向外晕染散开） */
.drop-glow-b {
  position: absolute;
  left: 50%;
  top: 537rpx;
  width: 260rpx;
  height: 260rpx;
  margin-left: -130rpx;
  margin-top: -130rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255,214,120,0.85) 0%, rgba(255,200,90,0.38) 40%, rgba(255,190,70,0) 70%);
  filter: blur(10rpx);
  opacity: 0;
  animation: drop-glow-b 1.15s ease-out 0.36s forwards;
}
@keyframes drop-glow-b {
  0% { transform: scale(0.4); opacity: 0; }
  28% { opacity: 0.9; }
  100% { transform: scale(2.3); opacity: 0; }
}

/* 光效周围小星芒 */
.fx-star {
  position: absolute;
  width: 18rpx;
  height: 18rpx;
  background: #fff3c4;
  clip-path: polygon(50% 0%, 65% 35%, 100% 50%, 65% 65%, 50% 100%, 35% 65%, 0% 50%, 35% 35%);
  opacity: 0;
  animation: fx-star 1.25s ease-out forwards;
}
.s1 { left: 236rpx; top: 462rpx; animation-delay: 0.15s; }
.s2 { left: 332rpx; top: 444rpx; animation-delay: 0.32s; }
.s3 { left: 306rpx; top: 506rpx; animation-delay: 0.24s; }
@keyframes fx-star {
  0% { transform: scale(0); opacity: 0; }
  30% { opacity: 1; }
  100% { transform: scale(1.7) translateY(-34rpx); opacity: 0; }
}

/* 金球：金色渐变球体，从出球口掉下 */
.drop-ball {
  position: absolute;
  left: 50%;
  top: 537rpx;
  width: 64rpx;
  height: 64rpx;
  margin-left: -32rpx;
  margin-top: -32rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 32% 28%, #fff8e0 0%, #ffe9a8 26%, #f5c85e 55%, #d99e2b 80%, #b87a16 100%);
  box-shadow:
    0 6rpx 18rpx rgba(180,130,40,0.45),
    inset 0 -4rpx 10rpx rgba(150,100,20,0.35);
  animation: drop-fall 0.38s cubic-bezier(0.4, 0, 1, 1) forwards;
  z-index: 6;
}
@keyframes drop-fall {
  0% { transform: translateY(0); }
  100% { transform: translateY(28rpx); }
}

/* 金球裂开两半，倒向两边（固定关键帧，不用 CSS 变量） */
.drop-half {
  position: absolute;
  left: 50%;
  top: 537rpx;
  width: 64rpx;
  height: 64rpx;
  margin-left: -32rpx;
  margin-top: -32rpx;
  opacity: 0;
  animation-duration: 0.85s;
  animation-timing-function: ease-out;
  animation-fill-mode: forwards;
  animation-delay: 0.38s;
  z-index: 5;
}
.half-l {
  background: radial-gradient(circle at 30% 30%, #fff3cd 0%, #f5c85e 55%, #d99e2b 80%);
  clip-path: polygon(50% 0%, 100% 0%, 100% 100%, 50% 100%);
  animation-name: half-split-l;
}
.half-r {
  background: radial-gradient(circle at 70% 30%, #fff3cd 0%, #f5c85e 55%, #d99e2b 80%);
  clip-path: polygon(0% 0%, 50% 0%, 50% 100%, 0% 100%);
  animation-name: half-split-r;
}
@keyframes half-split-l {
  0% { transform: translate(0, 28rpx) rotate(0deg); opacity: 1; }
  100% { transform: translate(-46rpx, 46rpx) rotate(-20deg); opacity: 0; }
}
@keyframes half-split-r {
  0% { transform: translate(0, 28rpx) rotate(0deg); opacity: 1; }
  100% { transform: translate(46rpx, 46rpx) rotate(20deg); opacity: 0; }
}





