/* pages/prompt/prompt.wxss */

page {
  background: #ffffff;
}

.container {
  min-height: 100vh;
  background: #ffffff;
  padding: 30rpx;
}

/* 标题 */
.title {
  text-align: center;
  margin-bottom: 40rpx;
}

.title-text {
  display: block;
  font-size: 38rpx;
  font-weight: bold;
  color: #222;
}

.subtitle {
  display: block;
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #666;
}

/* 输入区域 */
.prompt-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, .12);
}

.prompt-input {
  width: 100%;
  height: 620rpx;
  box-sizing: border-box;
  padding: 24rpx;
  background: #ffffff;
  border: 1rpx solid #ddd;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.7;
}

/* 按钮 */
.btn {
  width: 200rpx;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 24rpx;
  border-radius: 32rpx;
  font-size: 28rpx;
  font-weight: bold;
  color: #ffffff;
  margin-top: 16rpx;
}

.button-area {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.btn::after {
  border: none;
}

.save-btn {
  background: #a8c5e0;
}

.copy-btn {
  background: #c8b8e0;
}

.back-btn {
  background: #c8c8c8;
}