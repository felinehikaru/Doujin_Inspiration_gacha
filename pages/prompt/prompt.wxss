.container {
  padding: 30rpx;
}

.title {
  text-align: center;
  margin-bottom: 40rpx;
}

.title-text {
  font-size: 42rpx;
  font-weight: bold;
  display: block;
}

.subtitle {
  color: #888;
  font-size: 26rpx;
}

.main-btn {
  margin: 20rpx 0;
  border-radius: 20rpx;
}

.search {
  margin: 30rpx 0;
  border: 1rpx solid #ddd;
  padding: 20rpx;
  border-radius: 15rpx;
}

.category-box {
  margin-bottom: 40rpx;
}

.category-title {
  font-size: 34rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.entry-card {
  background: #fff;
  padding: 25rpx;
  margin-bottom: 20rpx;
  border-radius: 20rpx;
  box-shadow: 0 5rpx 15rpx #ddd;
}

.entry-name {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
}

.entry-desc {
  display: block;
  margin-top: 15rpx;
  color: #666;
}

.entry-tag {
  display: block;
  margin-top: 15rpx;
  color: #999;
}

.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, .5);
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-box {
  width: 80%;
  background: white;
  padding: 40rpx;
  border-radius: 25rpx;
}

.modal-box input,
.modal-box textarea {
  border: 1rpx solid #ddd;
  margin: 20rpx 0;
  padding: 20rpx;
  border-radius: 15rpx;
}

.picker {
  border: 1rpx solid #ddd;
  padding: 20rpx;
  border-radius: 15rpx;
  margin: 20rpx 0;
}