/* pages/prompt/prompt.wxss */

page {
  background: #ffffff;
}

.container {
  min-height: 100vh;
  background: #ffffff;
  padding: 30rpx;
}

/* 标题 */
.title {
  text-align: center;
  margin-bottom: 40rpx;
}

.title-text {
  display: block;
  font-size: 48rpx;
  font-weight: 900;
  color: #333;
}

.subtitle {
  display: block;
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #666;
}

/* 输入区域 */
.prompt-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, .12);
}

.prompt-input {
  width: 100%;
  height: 620rpx;
  box-sizing: border-box;
  padding: 24rpx;
  background: #ffffff;
  border: 1rpx solid #ddd;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.7;
}

/* 按钮 */
.button-area {
  margin-top: 40rpx;
}

.btn {
  height: 90rpx;
  line-height: 90rpx;
  border-radius: 45rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: white;
  margin-top: 20rpx;
}

.save-btn {
  background: #7b8ee8;
}

.copy-btn {
  background: #9b6de3;
}

.back-btn {
  background: #888;
}