<!-- pages/prompt/prompt.wxml -->
<view class="container">
  <view class="title">
    <text class="title-text">提示词模板</text>
    <text class="subtitle">可自由修改全部内容</text>
  </view>

  <!-- 完整可编辑提示词 -->
  <view class="prompt-card">
    <textarea
  class="prompt-input"
  value="{{prompt}}"
  bindinput="onPromptInput"
  maxlength="-1"
  cursor-spacing="20"
/>
  </view>

  <!-- 操作按钮 -->
  <view class="button-area">
    <button
      class="btn save-btn"
      bindtap="savePrompt"
    >保存修改</button>

    <button
      class="btn copy-btn"
      bindtap="copyPrompt"
    >一键复制</button>

    <button
      class="btn back-btn"
      bindtap="goBack"
    >返回</button>
  </view>
</view>