/* pages/history/history.wxss */

/* =====================
 页面基础
===================== */
page {
  background: #ffffff;
}

.container {
  min-height: 100vh;
  background: #ffffff;
  padding: 30rpx;
  box-sizing: border-box;
}

/* =====================
顶部
===================== */
.header {
  text-align: center;
  margin-bottom: 40rpx;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: 900;
  color: #333;
}

.count {
  display: block;
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #888;
}

/* =====================
历史列表
===================== */
.history-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* =====================
历史卡片
===================== */
.history-card {
  position: relative;
  background: linear-gradient(
    135deg,
    #f5f1fa,
    #ffffff
  );
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 8rpx 25rpx rgba(0, 0, 0, .08);
  border: 1rpx solid #eee;
}

.history-index {
  display: block;
  font-size: 24rpx;
  color: #998ca8;
  margin-bottom: 14rpx;
}

.history-text {
  display: block;
  font-size: 34rpx;
  color: #333;
  line-height: 1.6;
  word-break: break-all;
}

.history-time {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #999;
}

/* =====================
空状态
===================== */
.empty {
  text-align: center;
  margin-top: 200rpx;
  color: #999;
  font-size: 30rpx;
}

/* =====================
按钮
===================== */
.clear-btn {
  margin-top: 40rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  background: #d98f9b;
  color: #fff;
  font-size: 28rpx;
}

.back-btn {
  margin-top: 20rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  background: #ddd;
  color: #444;
  font-size: 28rpx;
}

button::after {
  border: none;
}